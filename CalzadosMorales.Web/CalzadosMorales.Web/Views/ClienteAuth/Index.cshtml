@{
    ViewData["Title"] = "Acceso - Calzados Morales";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome para íconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Poppins', sans-serif;
                background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .login-card {
                background: #ffffff;
                border-radius: 20px;
                box-shadow: 0 20px 40px rgba(0,0,0,0.2);
                overflow: hidden;
                width: 100%;
                max-width: 480px;
                padding: 40px;
            }

            .form-control {
                border-radius: 10px;
                padding: 12px 15px;
                border: 1px solid #dfe6e9;
                background-color: #f8f9fa;
            }

                .form-control:focus {
                    box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.15);
                    border-color: #2a5298;
                    background-color: #fff;
                }

            .btn-custom {
                border-radius: 10px;
                padding: 12px;
                font-weight: 600;
                transition: all 0.3s ease;
            }

            .btn-primary-custom {
                background: #2a5298;
                border: none;
                color: white;
            }

                .btn-primary-custom:hover {
                    background: #1e3c72;
                    color: white;
                    transform: translateY(-2px);
                }

            .nav-pills .nav-link {
                border-radius: 8px;
                color: #636e72;
                font-weight: 500;
                transition: all 0.3s;
            }

                .nav-pills .nav-link.active {
                    background-color: #2a5298;
                    color: white;
                    box-shadow: 0 4px 10px rgba(42, 82, 152, 0.3);
                }

            .modal-body-scroll {
                max-height: 75vh;
                overflow-y: auto;
            }

                .modal-body-scroll::-webkit-scrollbar {
                    width: 6px;
                }

                .modal-body-scroll::-webkit-scrollbar-thumb {
                    background-color: #b2bec3;
                    border-radius: 10px;
                }
    </style>
</head>
<body>

    <div class="container d-flex justify-content-center align-items-center">
        <div class="col-md-6 col-lg-5">

            <!-- Alertas flotantes -->
            @if (TempData["MensajeExito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["MensajeExito"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["MensajeError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["MensajeError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- TARJETA DE LOGIN PRINCIPAL -->
            <div class="login-card text-center">
                <div class="mb-4">
                    <div class="text-warning mb-2">
                        <i class="fa-solid fa-shoe-prints fa-3x"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Calzados Morales</h3>
                    <p class="text-muted small">Ingresa tus credenciales para acceder a la tienda.</p>
                </div>

                <form asp-controller="ClienteAuth" asp-action="IniciarSesion" method="POST" class="text-start">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-envelope"></i></span>
                            <input type="email" name="email" class="form-control border-start-0 ps-0" placeholder="tucorreo@email.com" required>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" name="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-warning btn-custom w-100 fw-bold shadow-sm text-dark mb-3">
                        Ingresar a la Tienda <i class="fa-solid fa-arrow-right ms-2"></i>
                    </button>
                </form>

                <hr class="text-muted my-4">

                <div>
                    <p class="text-muted small mb-2">¿Aún no tienes una cuenta?</p>
                    <button type="button" class="btn btn-outline-primary btn-custom w-100 fw-semibold" data-bs-toggle="modal" data-bs-target="#registroModal">
                        <i class="fa-solid fa-user-plus me-2"></i> Registrarme Ahora
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- MODAL DE REGISTRO PROFESIONAL -->
    <div class="modal fade" id="registroModal" tabindex="-1" aria-labelledby="registroModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-light px-4 pt-4 pb-3 border-0">
                    <div>
                        <h4 class="modal-title fw-bold text-dark" id="registroModalLabel">Crea tu cuenta en Calzados Morales</h4>
                        <p class="text-muted small mb-0">Selecciona tu tipo de perfil para comenzar el registro.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body modal-body-scroll px-4 pb-4">

                    <!-- Pestañas de Selección -->
                    <ul class="nav nav-pills nav-fill mb-4 bg-light p-1 rounded-3 shadow-sm" id="registroTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active py-2" id="natural-tab" data-bs-toggle="pill" data-bs-target="#natural-content" type="button" role="tab">
                                <i class="fa-solid fa-user me-2"></i> Persona Natural
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link py-2" id="juridica-tab" data-bs-toggle="pill" data-bs-target="#juridica-content" type="button" role="tab">
                                <i class="fa-solid fa-building me-2"></i> Persona Jurídica
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="registroTabContent">

                        <!-- FORMULARIO PERSONA NATURAL -->
                        <div class="tab-pane fade show active" id="natural-content" role="tabpanel">
                            <form asp-controller="ClienteAuth" asp-action="RegistrarPersonaNatural" method="POST">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">DNI (8 dígitos)</label>
                                        <input type="text" name="dni" class="form-control" maxlength="8" placeholder="Ej. 74839210" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Género</label>
                                        <select name="genero" class="form-select" required>
                                            <option value="">Seleccione...</option>
                                            <option value="1">Masculino</option>
                                            <option value="2">Femenino</option>
                                            <option value="3">Otro</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Nombres</label>
                                        <input type="text" name="nombre" class="form-control" placeholder="Ej. Juan Carlos" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Apellidos</label>
                                        <input type="text" name="apellido" class="form-control" placeholder="Ej. Pérez Gómez" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Teléfono (9 dígitos)</label>
                                        <input type="text" name="telefono" class="form-control" maxlength="9" placeholder="Ej. 987654321" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Correo Electrónico</label>
                                        <input type="email" name="email" class="form-control" placeholder="correo@dominio.com" required>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold small">Dirección</label>
                                        <input type="text" name="direccion" class="form-control" placeholder="Av. Principal 123, Lima" required>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold small">Contraseña</label>
                                        <input type="password" name="password" class="form-control" placeholder="Mínimo 4 caracteres" required>
                                    </div>
                                    <div class="col-12 mt-4">
                                        <button type="submit" class="btn btn-primary-custom btn-custom w-100 shadow-sm">
                                            <i class="fa-solid fa-user-plus me-2"></i> Registrarse como Persona Natural
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- FORMULARIO PERSONA JURÍDICA -->
                        <div class="tab-pane fade" id="juridica-content" role="tabpanel">
                            <form asp-controller="ClienteAuth" asp-action="RegistrarPersonaJuridica" method="POST">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">RUC (11 dígitos)</label>
                                        <input type="text" name="ruc" class="form-control" maxlength="11" placeholder="Ej. 20601234567" required>
                                        
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Razón Social</label>
                                        <input type="text" name="razonSocial" class="form-control" placeholder="Ej. Calzados S.A.C." required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Representante Legal</label>
                                        <input type="text" name="repreLegal" class="form-control" placeholder="Ej. María López" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Teléfono (9 dígitos)</label>
                                        <input type="text" name="telefono" class="form-control" maxlength="9" placeholder="Ej. 912345678" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Correo Electrónico</label>
                                        <input type="email" name="email" class="form-control" placeholder="empresa@dominio.com" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Dirección Fiscal</label>
                                        <input type="text" name="direccion" class="form-control" placeholder="Jr. Comercio 456, Lima" required>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold small">Contraseña</label>
                                        <input type="password" name="password" class="form-control" placeholder="Mínimo 4 caracteres" required>
                                    </div>
                                    <div class="col-12 mt-4">
                                        <button type="submit" class="btn btn-primary-custom btn-custom w-100 shadow-sm">
                                            <i class="fa-solid fa-building-shield me-2"></i> Registrarse como Empresa
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>