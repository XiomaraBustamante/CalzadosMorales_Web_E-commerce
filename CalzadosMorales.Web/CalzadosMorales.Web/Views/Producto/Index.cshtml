@model IEnumerable<CalzadosMorales.Web.Models.Producto>

@{
    ViewData["Title"] = "Inventario de Productos";
}

<div class="content-wrapper">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <h3 class="page-title font-weight-bold text-dark">
            <span class="page-title-icon bg-gradient-primary text-white me-2 shadow-sm">
                <i class="mdi mdi-shopping"></i>
            </span> Inventario de Productos
        </h3>
        <button type="button" class="btn btn-gradient-primary btn-icon-text shadow-sm" onclick="abrirModalRegistrar()">
            <i class="mdi mdi-plus btn-icon-prepend"></i> Nuevo Producto
        </button>
    </div>

    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-body">

                    <!-- Controles superiores -->
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div class="d-flex align-items-center">
                            <span class="me-2 text-dark font-weight-bold small">Mostrar</span>
                            <select class="form-select form-select-sm form-control form-control-sm w-auto d-inline-block">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <span class="ms-2 text-dark font-weight-bold small">registros</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <label class="me-2 text-dark font-weight-bold small mb-0">Buscar:</label>
                            <input type="text" class="form-control form-control-sm" id="inputBuscadorTabla" placeholder="" />
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="tablaProductos" width="100%">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th>Categoría</th>
                                    <th>Talla</th>
                                    <th>Color</th>
                                    <th>Material</th>
                                    <th>Precio</th>
                                    <th>Stock</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="font-weight-bold text-dark">@item.Nombre</td>
                                            <td>@item.CategoriaNombre</td>
                                            <td>@item.Talla</td>
                                            <td>@item.ColorNombre</td>
                                            <td>@item.MaterialTipo</td>
                                            <td class="font-weight-bold">S/ @item.Precio.ToString("N2")</td>
                                            <td class="text-info font-weight-bold">@item.Stock</td>
                                            <td>
                                                <span class="badge @(item.Estado ? "bg-success" : "bg-danger") text-white px-2 py-1">
                                                    @(item.Estado ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-primary text-white me-1" onclick="abrirModalEditar(@item.IdProducto)" title="Editar">
                                                    <i class="mdi mdi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-@(item.Estado ? "danger" : "success") text-white" onclick="cambiarEstadoProducto(@item.IdProducto, @item.Estado.ToString().ToLower())" title="@(item.Estado ? "Desactivar" : "Activar")">
                                                    <i class="mdi mdi-@(item.Estado ? "delete" : "check-circle")"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginación -->
                    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap">
                        <span class="text-dark font-weight-bold small">Mostrando registros del inventario</span>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item disabled"><a class="page-link" href="#">Anterior</a></li>
                                <li class="page-item active"><a class="page-link bg-gradient-primary border-0 text-white" href="#">1</a></li>
                                <li class="page-item disabled"><a class="page-link" href="#">Siguiente</a></li>
                            </ul>
                        </nav>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL UNIFICADO PARA NUEVO / EDITAR PRODUCTO -->
<div class="modal fade" id="modalProducto" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 1150px; width: 95%;">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">

            <div class="modal-header bg-gradient-primary text-white py-3 px-4">
                <h5 class="modal-title font-weight-bold" id="tituloModal">
                    <i class="mdi mdi-plus-box-outline me-1"></i> Nuevo Producto
                </h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Registrar" id="formProducto" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4 bg-light" style="max-height: 75vh; overflow-y: auto;">
                    <input type="hidden" id="IdProducto" name="IdProducto" value="0" />

                    <!-- INFORMACIÓN GENERAL -->
                    <div class="card border-0 shadow-sm mb-3 rounded-3">
                        <div class="card-body">
                            <h6 class="text-primary font-weight-bold mb-3">
                                <i class="mdi mdi-information-outline"></i> Información General
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label font-weight-bold text-dark small">Nombre Producto</label>
                                    <input type="text" class="form-control bg-white" id="Nombre" name="Nombre" placeholder="Ej. Bota de jebe" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label font-weight-bold text-dark small">Precio Base (S/)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-dark font-weight-bold">S/</span>
                                        <input type="number" step="0.01" class="form-control bg-white" id="Precio" name="Precio" placeholder="0.00" required />
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mt-1">
                                <div class="col-md-4">
                                    <label class="form-label font-weight-bold text-dark small">Categoría</label>
                                    <select class="form-select form-control bg-white" id="IdCategoria" name="IdCategoria" asp-items="@(new SelectList(ViewBag.ListaCategorias ?? new List<object>(), "IdCategoria", "Nombre"))" required>
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label font-weight-bold text-dark small">Color Principal</label>
                                    <select class="form-select form-control bg-white" id="IdColor" name="IdColor" asp-items="@(new SelectList(ViewBag.ListaColores ?? new List<object>(), "IdColor", "Nombre"))" required>
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label font-weight-bold text-dark small">Material</label>
                                    <select class="form-select form-control bg-white" id="IdMaterial" name="IdMaterial" asp-items="@(new SelectList(ViewBag.ListaMateriales ?? new List<object>(), "IdMaterial", "Tipo"))" required>
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-12">
                                    <label class="form-label font-weight-bold text-dark small">Descripción Corta</label>
                                    <textarea class="form-control bg-white" id="Descripcion" name="Descripcion" rows="2" placeholder="Breve detalle de las características..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SUBIDA DE IMÁGENES (Actualizado con ImagenFormModel y sus Ordenes explícitos) -->
                    <div class="card border-0 shadow-sm mb-3 rounded-3">
                        <div class="card-body">
                            <h6 class="text-primary font-weight-bold mb-1">
                                <i class="mdi mdi-image-multiple"></i> Subida del Carrusel Móvil (3 Fotos)
                            </h6>
                            <p class="text-dark small mb-3">Si edita, puede dejar los campos en blanco para conservar las imágenes actuales.</p>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="p-3 border rounded bg-white shadow-sm text-center h-100 d-flex flex-column justify-content-between">
                                        <span class="small font-weight-bold text-dark mb-2">Foto 1 (Principal Catálogo)</span>
                                        <div id="contenedor-imagen-0" class="mb-2"></div>
                                        <input type="hidden" name="imagenesForm[0].Orden" value="1" />
                                        <input type="file" name="imagenesForm[0].Archivo" class="form-control form-control-sm" accept="image/*" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 border rounded bg-white shadow-sm text-center h-100 d-flex flex-column justify-content-between">
                                        <span class="small font-weight-bold text-dark mb-2">Foto 2 (Modelo)</span>
                                        <div id="contenedor-imagen-1" class="mb-2"></div>
                                        <input type="hidden" name="imagenesForm[1].Orden" value="2" />
                                        <input type="file" name="imagenesForm[1].Archivo" class="form-control form-control-sm" accept="image/*" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 border rounded bg-white shadow-sm text-center h-100 d-flex flex-column justify-content-between">
                                        <span class="small font-weight-bold text-dark mb-2">Foto 3 (Ángulo Detalle/Suela)</span>
                                        <div id="contenedor-imagen-2" class="mb-2"></div>
                                        <input type="hidden" name="imagenesForm[2].Orden" value="3" />
                                        <input type="file" name="imagenesForm[2].Archivo" class="form-control form-control-sm" accept="image/*" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CURVA DE TALLAS Y STOCK DINÁMICA -->
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body">
                            <h6 class="text-primary font-weight-bold mb-1">
                                <i class="mdi mdi-format-list-bulleted"></i> Curva de Tallas y Stock Disponible
                            </h6>
                            <p class="text-dark small mb-3">Ingrese la cantidad en stock correspondiente para cada número de calzado.</p>

                            <div class="row g-3">
                                @{
                                    var listaTallas = ViewBag.ListaTallasTotal as List<CalzadosMorales.Web.Models.Talla>;
                                }
                                @if (listaTallas != null)
                                {
                                    int i = 0;
                                    foreach (var talla in listaTallas)
                                    {
                                        <div class="col-md-4">
                                            <input type="hidden" name="listaTallasStock[@i].IdTalla" value="@talla.IdTalla" />
                                            <div class="input-group shadow-sm">
                                                <span class="input-group-text font-weight-bold bg-white text-dark px-3" style="width: 110px;">@talla.Nombre</span>
                                                <input type="number" name="listaTallasStock[@i].Stock" class="form-control text-center bg-white stock-input" value="0" min="0" data-idtalla="@talla.IdTalla" />
                                            </div>
                                        </div>
                                        i++;
                                    }
                                }
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer bg-white border-top-0 py-3 px-4">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-gradient-primary px-4 shadow-sm">Guardar Producto</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function limpiarModal() {
            $("#formProducto")[0].reset();
            $("#IdProducto").val(0);
            $(".stock-input").val(0);
            for (let i = 0; i < 3; i++) {
                $(`#contenedor-imagen-${i}`).html('');
            }
        }

        function abrirModalRegistrar() {
            $("#tituloModal").html('<i class="mdi mdi-plus-box-outline me-1"></i> Nuevo Producto');
            $("#formProducto").attr("action", "/Producto/Registrar");
            limpiarModal();
            $("#modalProducto").modal("show");
        }

        function abrirModalEditar(id) {
            $("#tituloModal").html('<i class="mdi mdi-pencil-box-outline me-1"></i> Editar Producto');
            $("#formProducto").attr("action", "/Producto/Actualizar");
            limpiarModal();

            $.get("/Producto/ObtenerPorId?id=" + id, function(response) {
                if (response) {
                    let data = response.producto || response;
                    let tallasStock = response.listaTallasStock || data.listaTallasStock || data.ListaTallasStock;
                    let imagenes = response.imagenes || data.imagenes || [];

                    // Setear campos generales
                    $("#IdProducto").val(data.idProducto || data.IdProducto);
                    $("#Nombre").val(data.nombre || data.Nombre);
                    $("#Precio").val(data.precio || data.Precio);
                    $("#IdCategoria").val(data.idCategoria || data.IdCategoria);
                    $("#IdColor").val(data.idColor || data.IdColor);
                    $("#IdMaterial").val(data.idMaterial || data.IdMaterial);
                    $("#Descripcion").val(data.descripcion || data.Descripcion);

                    // Cargar Tallas y Stock
                    if (tallasStock && tallasStock.length > 0) {
                        $.each(tallasStock, function(index, item) {
                            let idTallaVal = item.idTalla || item.IdTalla;
                            let stockVal = item.stock !== undefined ? item.stock : item.Stock;
                            let inputStock = $('.stock-input[data-idtalla="' + idTallaVal + '"]');
                            if (inputStock.length > 0) {
                                inputStock.val(stockVal);
                            }
                        });
                    }

                    // Cargar imágenes actuales en sus slots correspondientes (0, 1, 2) usando la propiedad 'orden'
                    if (imagenes && imagenes.length > 0) {
                        $.each(imagenes, function(index, img) {
                            let urlImg = img.imagenUrl || img.ImagenUrl || img.urlImagen || img.UrlImagen;
                            // Mapea basándose en la propiedad 'orden' de la BD (ej. orden 1 -> slot 0)
                            let ordenVal = img.orden !== undefined ? img.orden : (img.Orden !== undefined ? img.Orden : 0);
                            let slotIndex = (ordenVal > 0) ? ordenVal - 1 : index;

                            if (slotIndex < 3 && urlImg) {
                                let htmlImg = `
                                                    <img src="${urlImg}" class="rounded shadow-sm mb-1" style="width: 60px; height: 60px; object-fit: cover;" />
                                                    <div><span class="badge bg-success text-white" style="font-size: 10px;">Slot ${slotIndex + 1} Actual</span></div>
                                                `;
                                $(`#contenedor-imagen-${slotIndex}`).html(htmlImg);
                            }
                        });
                    }

                    $("#modalProducto").modal("show");
                }
            });
        }

        function cambiarEstadoProducto(id, estadoActual) {
            let nuevoEstado = !estadoActual;
            let mensaje = nuevoEstado ? "¿Desea activar este producto?" : "¿Está seguro de desactivar este producto?";

            if (confirm(mensaje)) {
                $.post("/Producto/CambiarEstado", { idProducto: id, estado: nuevoEstado }, function(res) {
                    location.reload();
                });
            }
        }
    </script>
}