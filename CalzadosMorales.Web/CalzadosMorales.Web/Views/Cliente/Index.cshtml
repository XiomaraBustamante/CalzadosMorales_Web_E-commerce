@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="container-fluid px-4 py-3">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold mb-0">Gestión de Clientes</h2>
            <p class="text-muted small mb-0">Administra personas naturales y jurídicas de Calzados Morales</p>
        </div>
        <div>
            <button class="btn btn-primary shadow-sm me-2" data-bs-toggle="modal" data-bs-target="#modalNatural" onclick="prepararRegistroNatural()">
                <i class="fas fa-user-plus me-1"></i> Nueva Persona Natural
            </button>
            <button class="btn btn-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#modalJuridica" onclick="prepararRegistroJuridica()">
                <i class="fas fa-building me-1"></i> Nueva Persona Jurídica
            </button>
        </div>
    </div>

    <!-- Pestañas de Navegación -->
    <ul class="nav nav-tabs mb-3" id="clienteTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="natural-tab" data-bs-toggle="tab" data-bs-target="#natural-pane" type="button" role="tab">
                <i class="fas fa-user me-2"></i> Personas Naturales
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="juridica-tab" data-bs-toggle="tab" data-bs-target="#juridica-pane" type="button" role="tab">
                <i class="fas fa-store me-2"></i> Personas Jurídicas
            </button>
        </li>
    </ul>

    <!-- Contenido de las Pestañas -->
    <div class="tab-content" id="clienteTabsContent">

        <!-- PESTAÑA: PERSONAS NATURALES -->
        <div class="tab-pane fade show active" id="natural-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light text-secondary small text-uppercase">
                                <tr>
                                    <th>ID</th>
                                    <th>DNI</th>
                                    <th>Nombres y Apellidos</th>
                                    <th>Género</th>
                                    <th>Teléfono</th>
                                    <th>Email</th>
                                    <th>Dirección</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.ListaNaturales != null)
                                {
                                    foreach (var item in ViewBag.ListaNaturales)
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.IdCliente</td>
                                            <td>@item.Dni</td>
                                            <td>@item.Nombre @item.Apellido</td>
                                            <td>@(item.Genero == 1 ? "Masculino" : "Femenino")</td>
                                            <td>@item.Cliente?.Telefono</td>
                                            <td>@item.Cliente?.Email</td>
                                            <td>@item.Cliente?.Direccion</td>
                                            <td>
                                                @if (item.Cliente != null && item.Cliente.Estado)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary me-1" onclick="abrirEditarNatural(@item.IdCliente)" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm @(item.Cliente != null && item.Cliente.Estado ? "btn-outline-danger" : "btn-outline-success")" onclick="cambiarEstadoNatural(@item.IdCliente, @(item.Cliente != null && item.Cliente.Estado ? "false" : "true"))" title="Cambiar Estado">
                                                    <i class="fas @(item.Cliente != null && item.Cliente.Estado ? "fa-ban" : "fa-check")"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- PESTAÑA: PERSONAS JURÍDICAS -->
        <div class="tab-pane fade" id="juridica-pane" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light text-secondary small text-uppercase">
                                <tr>
                                    <th>ID</th>
                                    <th>RUC</th>
                                    <th>Razón Social</th>
                                    <th>Rep. Legal</th>
                                    <th>Teléfono</th>
                                    <th>Email</th>
                                    <th>Dirección</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.ListaJuridicas != null)
                                {
                                    foreach (var item in ViewBag.ListaJuridicas)
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.IdCliente</td>
                                            <td>@item.Ruc</td>
                                            <td>@item.RazonSocial</td>
                                            <td>@item.RepreLegal</td>
                                            <td>@item.Cliente?.Telefono</td>
                                            <td>@item.Cliente?.Email</td>
                                            <td>@item.Cliente?.Direccion</td>
                                            <td>
                                                @if (item.Cliente != null && item.Cliente.Estado)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary me-1" onclick="abrirEditarJuridica(@item.IdCliente)" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm @(item.Cliente != null && item.Cliente.Estado ? "btn-outline-danger" : "btn-outline-success")" onclick="cambiarEstadoJuridica(@item.IdCliente, @(item.Cliente != null && item.Cliente.Estado ? "false" : "true"))" title="Cambiar Estado">
                                                    <i class="fas @(item.Cliente != null && item.Cliente.Estado ? "fa-ban" : "fa-check")"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: PERSONA NATURAL (REGISTRO / EDIT) -->
<!-- ========================================== -->
<div class="modal fade" id="modalNatural" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <form id="formNatural" method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="tituloModalNatural">Registrar Persona Natural</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="natIdCliente" name="idCliente" value="0" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">DNI</label>
                            <input type="text" class="form-control" id="natDni" name="dni" required maxlength="8" placeholder="8 dígitos">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Género</label>
                            <select class="form-select" id="natGenero" name="genero" required>
                                <option value="">Seleccione...</option>
                                <option value="1">Masculino</option>
                                <option value="2">Femenino</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Nombre</label>
                            <input type="text" class="form-control" id="natNombre" name="nombre" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Apellido</label>
                            <input type="text" class="form-control" id="natApellido" name="apellido" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Teléfono</label>
                            <input type="tel" class="form-control" id="natTelefono" name="telefono" required maxlength="9" placeholder="Ej. 987654321">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Email</label>
                            <input type="email" class="form-control" id="natEmail" name="email" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Contraseña</label>
                            <input type="password" class="form-control" id="natPassword" name="password" placeholder="••••••••" required>
                            <small class="text-muted" id="natPasswordHelp">Obligatorio al registrar.</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Dirección</label>
                            <input type="text" class="form-control" id="natDireccion" name="direccion" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: PERSONA JURÍDICA (REGISTRO / EDIT) -->
<!-- ========================================== -->
<div class="modal fade" id="modalJuridica" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <form id="formJuridica" method="post">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="tituloModalJuridica">Registrar Persona Jurídica</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="jurIdCliente" name="idCliente" value="0" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">RUC</label>
                            <input type="text" class="form-control" id="jurRuc" name="ruc" required maxlength="11" placeholder="11 dígitos">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Razón Social</label>
                            <input type="text" class="form-control" id="jurRazonSocial" name="razonSocial" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Representante Legal</label>
                        <input type="text" class="form-control" id="jurRepreLegal" name="repreLegal" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Teléfono</label>
                            <input type="tel" class="form-control" id="jurTelefono" name="telefono" required maxlength="9" placeholder="Ej. 987654321">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Email</label>
                            <input type="email" class="form-control" id="jurEmail" name="email" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Contraseña</label>
                            <input type="password" class="form-control" id="jurPassword" name="password" placeholder="••••••••" required>
                            <small class="text-muted" id="jurPasswordHelp">Obligatorio al registrar.</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Dirección</label>
                            <input type="text" class="form-control" id="jurDireccion" name="direccion" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-dark">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Restricción estricta de solo números en los inputs de teléfono y documentos
            const inputsTelefono = document.querySelectorAll('input[type="tel"]');
            inputsTelefono.forEach(input => {
                input.addEventListener("input", function() {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            });

            const inputDni = document.getElementById('natDni');
            if (inputDni) {
                inputDni.addEventListener("input", function() {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            }

            const inputRuc = document.getElementById('jurRuc');
            if (inputRuc) {
                inputRuc.addEventListener("input", function() {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            }

            // Interceptar formulario Persona Natural (AJAX)
            const formNatural = document.getElementById("formNatural");
            formNatural.addEventListener("submit", function(e) {
                e.preventDefault();
                const url = this.action;
                const formData = new FormData(this);

                fetch(url, {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(result => {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: '¡Éxito!',
                                text: result.message,
                                confirmButtonText: 'Aceptar'
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Atención',
                                text: result.message,
                                confirmButtonText: 'Entendido'
                            });
                        }
                    })
                    .catch(() => {
                        Swal.fire('Error', 'Ocurrió un error inesperado en la red.', 'error');
                    });
            });

            // Interceptar formulario Persona Jurídica (AJAX)
            const formJuridica = document.getElementById("formJuridica");
            formJuridica.addEventListener("submit", function(e) {
                e.preventDefault();
                const url = this.action;
                const formData = new FormData(this);

                fetch(url, {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(result => {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: '¡Éxito!',
                                text: result.message,
                                confirmButtonText: 'Aceptar'
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Atención',
                                text: result.message,
                                confirmButtonText: 'Entendido'
                            });
                        }
                    })
                    .catch(() => {
                        Swal.fire('Error', 'Ocurrió un error inesperado en la red.', 'error');
                    });
            });
        });

        // Funciones para Persona Natural
        function prepararRegistroNatural() {
            document.getElementById("formNatural").action = "/Cliente/RegistrarNatural";
            document.getElementById("tituloModalNatural").innerText = "Registrar Persona Natural";
            document.getElementById("natIdCliente").value = "0";
            document.getElementById("formNatural").reset();

            // Asegurar que la contraseña sea obligatoria en nuevo registro
            const passInput = document.getElementById("natPassword");
            passInput.setAttribute("required", "required");
            document.getElementById("natPasswordHelp").innerText = "Obligatorio al registrar.";
        }

        function abrirEditarNatural(id) {
            fetch('/Cliente/ObtenerNaturalPorId?id=' + id)
                .then(response => response.json())
                .then(res => {
                    if (!res.success) {
                        Swal.fire('Error', res.message, 'error');
                        return;
                    }
                    const data = res.data;
                    document.getElementById("formNatural").action = "/Cliente/ActualizarNatural";
                    document.getElementById("tituloModalNatural").innerText = "Actualizar Persona Natural";

                    document.getElementById("natIdCliente").value = data.idCliente;
                    document.getElementById("natDni").value = data.dni;
                    document.getElementById("natGenero").value = data.genero;
                    document.getElementById("natNombre").value = data.nombre;
                    document.getElementById("natApellido").value = data.apellido;

                    document.getElementById("natTelefono").value = data.cliente.telefono;
                    document.getElementById("natEmail").value = data.cliente.email;
                    document.getElementById("natDireccion").value = data.cliente.direccion;

                    // Al editar, la contraseña puede ser opcional (dejar en blanco para no cambiar)
                    const passInput = document.getElementById("natPassword");
                    passInput.value = "";
                    passInput.removeAttribute("required");
                    document.getElementById("natPasswordHelp").innerText = "Dejar en blanco para mantener la actual.";

                    var myModal = new bootstrap.Modal(document.getElementById('modalNatural'));
                    myModal.show();
                })
                .catch(() => Swal.fire('Error', 'No se pudieron cargar los datos del cliente.', 'error'));
        }

        function cambiarEstadoNatural(idCliente, nuevoEstado) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: "Se cambiará el estado de este cliente.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, cambiar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const formData = new FormData();
                    formData.append('idCliente', idCliente);
                    formData.append('estado', nuevoEstado);

                    fetch('/Cliente/CambiarEstadoNatural', {
                        method: 'POST',
                        body: formData
                    })
                        .then(response => response.json())
                        .then(res => {
                            if (res.success) {
                                Swal.fire('¡Actualizado!', res.message, 'success').then(() => location.reload());
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        });
                }
            });
        }

        // Funciones para Persona Jurídica
        function prepararRegistroJuridica() {
            document.getElementById("formJuridica").action = "/Cliente/RegistrarJuridica";
            document.getElementById("tituloModalJuridica").innerText = "Registrar Persona Jurídica";
            document.getElementById("jurIdCliente").value = "0";
            document.getElementById("formJuridica").reset();

            // Asegurar que la contraseña sea obligatoria en nuevo registro
            const passInput = document.getElementById("jurPassword");
            passInput.setAttribute("required", "required");
            document.getElementById("jurPasswordHelp").innerText = "Obligatorio al registrar.";
        }

        function abrirEditarJuridica(id) {
            fetch('/Cliente/ObtenerJuridicaPorId?id=' + id)
                .then(response => response.json())
                .then(res => {
                    if (!res.success) {
                        Swal.fire('Error', res.message, 'error');
                        return;
                    }
                    const data = res.data;
                    document.getElementById("formJuridica").action = "/Cliente/ActualizarJuridica";
                    document.getElementById("tituloModalJuridica").innerText = "Actualizar Persona Jurídica";

                    document.getElementById("jurIdCliente").value = data.idCliente;
                    document.getElementById("jurRuc").value = data.ruc;
                    document.getElementById("jurRazonSocial").value = data.razonSocial;
                    document.getElementById("jurRepreLegal").value = data.repreLegal;

                    document.getElementById("jurTelefono").value = data.cliente.telefono;
                    document.getElementById("jurEmail").value = data.cliente.email;
                    document.getElementById("jurDireccion").value = data.cliente.direccion;

                    // Al editar, la contraseña puede ser opcional (dejar en blanco para no cambiar)
                    const passInput = document.getElementById("jurPassword");
                    passInput.value = "";
                    passInput.removeAttribute("required");
                    document.getElementById("jurPasswordHelp").innerText = "Dejar en blanco para mantener la actual.";

                    var myModal = new bootstrap.Modal(document.getElementById('modalJuridica'));
                    myModal.show();
                })
                .catch(() => Swal.fire('Error', 'No se pudieron cargar los datos de la empresa.', 'error'));
        }

        function cambiarEstadoJuridica(idCliente, nuevoEstado) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: "Se cambiará el estado de esta empresa.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, cambiar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const formData = new FormData();
                    formData.append('idCliente', idCliente);
                    formData.append('estado', nuevoEstado);

                    fetch('/Cliente/CambiarEstadoJuridica', {
                        method: 'POST',
                        body: formData
                    })
                        .then(response => response.json())
                        .then(res => {
                            if (res.success) {
                                Swal.fire('¡Actualizado!', res.message, 'success').then(() => location.reload());
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        });
                }
            });
        }
    </script>
}