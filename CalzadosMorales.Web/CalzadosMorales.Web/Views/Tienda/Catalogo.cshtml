@model List<CalzadosMorales.Web.Models.ProductoTienda>

@{
    ViewData["Title"] = "Catálogo de Productos";

   string imagenBanner = "~/Tienda/assets/images/default.jpg"; 
    string fraseBanner = "Explora nuestros productos exclusivos de Calzados Morales";

    switch (ViewBag.CategoriaActual)
    {
        case "Zapatillas":
            imagenBanner = "~/Tienda/assets/images/zapatillasfondo.jpg";
            fraseBanner = "Pisa fuerte, llega lejos y marca tu propio estilo en cada paso.";
            break;
        case "Sandalias":
            imagenBanner = "~/Tienda/assets/images/sandaliasfondo.jpeg";
            fraseBanner = "Frescura, comodidad y libertad para tus días de verano.";
            break;
        case "Zapatos":
            imagenBanner = "~/Tienda/assets/images/zapatosfondo.jpg";
            fraseBanner = "Elegancia y distinción para las ocasiones que más importan.";
            break;
        case "Botines":
            imagenBanner = "~/Tienda/assets/images/botinesfondo.jpeg";
            fraseBanner = "Máximo agarre, velocidad y control para dominar la cancha.";
            break;
        case "Mocasines":
            imagenBanner = "~/Tienda/assets/images/mocasionesfondo.jpeg";
            fraseBanner = "Estilo clásico y confort superior para el día a día.";
            break;
        // Categorías adicionales por si llegan desde Hombre, Mujer o Niños
        case "Hombre":
            imagenBanner = "~/Tienda/assets/images/zapatillasfondo.jpg";
            fraseBanner = "Diseños modernos, máxima comodidad y distinción para cada aventura.";
            break;
        case "Mujer":
            imagenBanner = "~/Tienda/assets/images/sandaliasfondo.jpeg";
            fraseBanner = "Encuentra el par perfecto que realce tu gracia y elegancia única.";
            break;
        case "Niño":
            imagenBanner = "~/Tienda/assets/images/zapatosfondo.jpg";
            fraseBanner = "Calzado resistente y flexible para acompañar sus juegos y travesuras.";
            break;
    }
}

<!-- ***** Main Banner Area Start (Banner tal cual lo tenías inicialmente) ***** -->
<div class="page-heading" id="top" style="background-image: url('@Url.Content(imagenBanner)'); background-position: center center; background-repeat: no-repeat; background-size: cover; margin-top: -30px; height: 800px; display: flex; align-items: center; justify-content: center; position: relative;">
    
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.2); z-index: 1;"></div>

    <div class="container" style="z-index: 2;">
        <div class="row">
            <div class="col-lg-12 text-center">
                <h2 class="text-white text-uppercase mb-3" style="font-size: 5rem; font-family: 'Georgia', serif; font-weight: bold; letter-spacing: 4px; text-shadow: 3px 3px 10px rgba(0,0,0,0.8), -1px -1px 0 rgba(0,0,0,0.5);">
                    @ViewBag.CategoriaActual
                </h2>
                <p class="text-light m-0" style="font-size: 1.8rem; font-style: italic; text-shadow: 2px 2px 8px rgba(0,0,0,0.9);">
                    @fraseBanner
                </p>
            </div>
        </div>
    </div>
</div>
<!-- ***** Main Banner Area End ***** -->

<!-- ***** Products Area Starts (Sección con fondo cálido suave que contiene todo) ***** -->
<section class="section pt-5 pb-5" id="products" style="background-color: #fdfbf7;"> 
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <!-- Título exactamente idéntico al de tu imagen -->
                <div class="text-center p-4 mb-5 rounded shadow-sm bg-white" style="border-top: 4px solid #232323; max-width: 700px; margin: 0 auto;">
                    <h2 class="fw-bold text-dark mb-2" style="font-size: 2rem;">Nuestros Últimos Productos</h2>
                    <span class="text-muted fs-6">Revisa todo nuestro stock disponible con la mejor calidad.</span>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var p in Model)
                {
                    var listaFotos = !string.IsNullOrEmpty(p.ImagenesUnidas) ? p.ImagenesUnidas.Split('|') : new string[0];

                    <div class="col-lg-4 col-md-6 mb-4">
                        <!-- Tarjetas idénticas a tu imagen con su estructura y estilos -->
                        <div class="item h-100 d-flex flex-column shadow border-0 rounded overflow-hidden bg-white">
                            
                            <!-- CONTENEDOR THUMB -->
                            <div class="thumb position-relative bg-light">
                                <div id="carousel_@p.IdProducto" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                                    <div class="carousel-inner">
                                        @if (listaFotos.Length > 0)
                                        {
                                            @for (int i = 0; i < listaFotos.Length; i++)
                                            {
                                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                                    <img src="@listaFotos[i]" class="d-block w-100" alt="Imagen de @p.Nombre" style="height: 260px; object-fit: cover; object-position: center;">
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="carousel-item active">
                                                <img src="~/Tienda/assets/images/default.png" class="d-block w-100" alt="Sin imagen" style="height: 260px; object-fit: cover; object-position: center;">
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="hover-content">
                                    <ul>
                                        <li><a href="#"><i class="fa fa-eye"></i></a></li>
                                        <li><a href="#"><i class="fa fa-star"></i></a></li>
                                        <li><a href="#"><i class="fa fa-shopping-cart"></i></a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- CONTENIDO DE LA TARJETA -->
                            <div class="down-content p-3 mt-auto d-flex flex-column text-center align-items-center" style="background-color: #fafbfc;">
                                <div class="tarjeta-info-producto w-100" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                    
                                    <!-- Nombre del producto -->
                                    <h4 class="fs-5 fw-bold text-dark mb-2" style="width: 100%; margin: 0 0 8px 0; float: none; clear: both; display: block;">@p.Nombre</h4>
                                    
                                    <!-- Estrellas -->
                                    <div style="width: 100%; margin-bottom: 8px; float: none; clear: both; display: block; text-align: center;">
                                        <ul class="list-unstyled text-warning" style="display: inline-flex; gap: 3px; margin: 0; padding: 0; float: none;">
                                            <li><i class="fa fa-star"></i></li>
                                            <li><i class="fa fa-star"></i></li>
                                            <li><i class="fa fa-star"></i></li>
                                            <li><i class="fa fa-star"></i></li>
                                            <li><i class="fa fa-star"></i></li>
                                        </ul>
                                    </div>

                                    <!-- Precio -->
                                    <span class="text-success fw-bold fs-5" style="width: 100%; margin-bottom: 12px; float: none; clear: both; display: block;">S/ @p.Precio.ToString("0.00")</span>
                                
                                </div>

                                <!-- Botón Detalle -->
                                <a href="#" class="btn btn-dark btn-sm mt-auto w-100 py-2">Ver Detalle</a>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-lg-12">
                    <div class="alert alert-warning text-center p-4">No hay productos disponibles en esta categoría.</div>
                </div>
            }

            <!-- PAGINACIÓN DINÁMICA -->
            <div class="col-lg-12 mt-4">
                <div class="pagination d-flex justify-content-center">
                    <ul class="list-inline">
                        @{
                            int paginaActual = ViewBag.PaginaActual;
                            int totalPaginas = ViewBag.TotalPaginas;
                            string categoria = ViewBag.CategoriaActual;
                        }

                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            <li class="list-inline-item @(paginaActual == i ? "active" : "")">
                                <a href="@Url.Action("Catalogo", "Tienda", new { categoria = categoria, pagina = i })" class="btn @(paginaActual == i ? "btn-dark" : "btn-light") border px-3">@i</a>
                            </li>
                        }

                        @if (paginaActual < totalPaginas)
                        {
                            <li class="list-inline-item">
                                <a href="@Url.Action("Catalogo", "Tienda", new { categoria = categoria, pagina = paginaActual + 1 })" class="btn btn-light border px-3">></a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ***** Products Area Ends ***** -->