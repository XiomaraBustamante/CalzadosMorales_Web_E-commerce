@model CalzadosMorales.Web.Models.CatalogoCompletoViewModel

@{
    ViewData["Title"] = "Catálogo Avanzado - Calzados Morales";
}

<!-- ***** Main Banner Area Start ***** -->
<div class="page-heading position-relative d-flex align-items-center justify-content-center text-center"
     style="background-image: url('@Url.Content("~/Tienda/assets/images/zapatillasfondo.jpg")'); background-position: center; background-repeat: no-repeat; background-size: cover; height: 700px; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; margin-top: -30px;">

    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.75)); z-index: 1;"></div>

    <div class="container" style="z-index: 2;">
        <div class="row justify-content-center">
            <div class="col-12">
                <span class="text-uppercase text-light d-block mb-2" style="font-size: 1.1rem; letter-spacing: 10px; font-weight: 700; text-shadow: 0 3px 6px rgba(0,0,0,0.6);">Calzados Morales</span>
                <h1 class="text-white text-uppercase mt-1 mb-3" style="font-size: 5.2rem; font-weight: 900; letter-spacing: 5px; text-shadow: 0 6px 30px rgba(0,0,0,0.7);">
                    Catálogo de Productos
                </h1>
                <p class="text-light m-0 mx-auto" style="font-size: 1.7rem; font-style: italic; max-width: 900px; font-weight: 300; text-shadow: 0 3px 10px rgba(0,0,0,0.7);">
                    Encuentra el calzado perfecto para ti con estilo, confort y exclusividad.
                </p>
            </div>
        </div>
    </div>
</div>
<!-- ***** Main Banner Area End ***** -->
<!-- ***** Catalog Area Starts ***** -->
<section class="section pt-5 pb-5" id="products" style="background-color: #f8f9fa;">
    <div class="container-fluid px-lg-5">

        <!-- FORMULARIO GLOBAL QUE ENGLOBA TODO -->
        <form method="get" asp-action="CatalogoAvanzado" asp-controller="Tienda" id="formFiltrosGlobal">

            <!-- CAMPOS OCULTOS PARA LOS FILTROS -->
            <input type="hidden" name="id_categoria" id="inputCategoria" value="@ViewBag.CategoriaSeleccionada" />
            <input type="hidden" name="id_color" id="inputColor" value="@ViewBag.ColorSeleccionado" />
            <input type="hidden" name="id_material" id="inputMaterial" value="@ViewBag.MaterialSeleccionado" />
            <input type="hidden" name="id_talla" id="inputTalla" value="@ViewBag.TallaSeleccionada" />

            <!-- BARRA SUPERIOR DE BÚSQUEDA Y ORDEN -->
            <div class="row mb-4">
                <div class="col-lg-12">
                    <div class="card shadow-sm border-0 p-3 bg-white rounded-4">
                        <div class="row align-items-center g-3">
                            <div class="col-lg-8">
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0 text-muted ps-3"><i class="fa fa-search"></i></span>
                                    <input type="text" name="busqueda" value="@ViewBag.BusquedaActual" class="form-control bg-light border-0 py-2 shadow-none" placeholder="Buscar por nombre de calzado...">
                                    <button class="btn btn-dark px-4 fw-semibold rounded-end" type="submit" onclick="guardarPosicion()">
                                        Buscar
                                    </button>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="d-flex align-items-center justify-content-end bg-light rounded-3 px-3 py-1 border-0">
                                    <span class="text-muted small me-2 text-nowrap"><i class="fa fa-sort me-1"></i> Ordenar:</span>
                                    <select name="orden" class="form-select border-0 bg-transparent shadow-none fw-semibold text-dark cursor-pointer" onchange="guardarPosicion(); this.form.submit();">
                                        <option value="recientes" selected="@(ViewBag.OrdenActual == "recientes")">Más Recientes</option>
                                        <option value="precio_asc" selected="@(ViewBag.OrdenActual == "precio_asc")">Precio: Menor a Mayor</option>
                                        <option value="precio_desc" selected="@(ViewBag.OrdenActual == "precio_desc")">Precio: Mayor a Menor</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CONTENIDO PRINCIPAL: FILTROS MODERNOS Y PRODUCTOS -->
            <div class="row">

                <!-- PANEL LATERAL DE FILTROS PROFESIONAL -->
                <div class="col-lg-3 mb-4">
                    <div class="p-4 bg-white shadow-sm rounded-4 border-0">

                        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                            <h5 class="fw-bold text-dark m-0" style="font-size: 1.1rem;">
                                <i class="fa fa-sliders me-2 text-dark"></i>Filtros
                            </h5>
                            <a href="@Url.Action("CatalogoAvanzado", "Tienda")" class="text-decoration-none text-danger small fw-bold px-2 py-1 rounded bg-light hover-danger">
                                <i class="fa fa-rotate-left me-1"></i> Limpiar
                            </a>
                        </div>

                        <!-- ACORDEÓN DE FILTROS -->
                        <div class="accordion accordion-flush" id="accordionFiltros">

                            <!-- 1. CATEGORÍAS -->
                            <div class="accordion-item border-0 mb-3 bg-transparent">
                                <h2 class="accordion-header" id="headingCategoria">
                                    <button class="accordion-button @(ViewBag.CategoriaSeleccionada != null ? "" : "collapsed") filter-box-btn py-2 px-3 fw-semibold text-dark shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCategoria" aria-expanded="@(ViewBag.CategoriaSeleccionada != null ? "true" : "false")" aria-controls="collapseCategoria" style="font-size: 0.95rem;">
                                        <i class="fa fa-tag me-2 text-secondary"></i> Categorías
                                    </button>
                                </h2>
                                <div id="collapseCategoria" class="accordion-collapse collapse @(ViewBag.CategoriaSeleccionada != null ? "show" : "")" aria-labelledby="headingCategoria" data-bs-parent="#accordionFiltros">
                                    <div class="accordion-body px-1 py-2">
                                        <div class="d-flex flex-column gap-1">
                                            <a href="#" onclick="cambiarFiltro('categoria', ''); return false;" class="py-2 px-3 rounded-2 text-decoration-none transition-all @(ViewBag.CategoriaSeleccionada == null ? "bg-dark text-white fw-bold shadow-sm" : "text-secondary bg-light-hover")" style="font-size: 0.88rem;">
                                                Todas las categorías
                                            </a>
                                            @if (Model.ListaCategorias != null)
                                            {
                                                foreach (var cat in Model.ListaCategorias)
                                                {
                                                    bool activo = ViewBag.CategoriaSeleccionada != null && (int)ViewBag.CategoriaSeleccionada == cat.id_categoria;
                                                    <a href="#" onclick="cambiarFiltro('categoria', '@cat.id_categoria'); return false;" class="py-2 px-3 rounded-2 text-decoration-none transition-all @(activo ? "bg-dark text-white fw-bold shadow-sm" : "text-secondary bg-light-hover")" style="font-size: 0.88rem;">
                                                        @cat.nombre
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. COLORES -->
                            <div class="accordion-item border-0 mb-3 bg-transparent">
                                <h2 class="accordion-header" id="headingColor">
                                    <button class="accordion-button @(ViewBag.ColorSeleccionado != null ? "" : "collapsed") filter-box-btn py-2 px-3 fw-semibold text-dark shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseColor" aria-expanded="@(ViewBag.ColorSeleccionado != null ? "true" : "false")" aria-controls="collapseColor" style="font-size: 0.95rem;">
                                        <i class="fa fa-palette me-2 text-secondary"></i> Colores
                                    </button>
                                </h2>
                                <div id="collapseColor" class="accordion-collapse collapse @(ViewBag.ColorSeleccionado != null ? "show" : "")" aria-labelledby="headingColor" data-bs-parent="#accordionFiltros">
                                    <div class="accordion-body px-1 py-2">
                                        <div class="d-flex flex-column gap-1">
                                            <a href="#" onclick="cambiarFiltro('color', ''); return false;" class="py-2 px-3 rounded-2 text-decoration-none transition-all @(ViewBag.ColorSeleccionado == null ? "bg-dark text-white fw-bold shadow-sm" : "text-secondary bg-light-hover")" style="font-size: 0.88rem;">
                                                Todos los colores
                                            </a>
                                            @if (Model.ListaColores != null)
                                            {
                                                foreach (var col in Model.ListaColores)
                                                {
                                                    bool activo = ViewBag.ColorSeleccionado != null && (int)ViewBag.ColorSeleccionado == col.id_color;
                                                    <a href="#" onclick="cambiarFiltro('color', '@col.id_color'); return false;" class="py-2 px-3 rounded-2 text-decoration-none transition-all @(activo ? "bg-dark text-white fw-bold shadow-sm" : "text-secondary bg-light-hover")" style="font-size: 0.88rem;">
                                                        @col.nombre
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. MATERIALES -->
                            <div class="accordion-item border-0 mb-3 bg-transparent">
                                <h2 class="accordion-header" id="headingMaterial">
                                    <button class="accordion-button @(ViewBag.MaterialSeleccionado != null ? "" : "collapsed") filter-box-btn py-2 px-3 fw-semibold text-dark shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMaterial" aria-expanded="@(ViewBag.MaterialSeleccionado != null ? "true" : "false")" aria-controls="collapseMaterial" style="font-size: 0.95rem;">
                                        <i class="fa fa-gem me-2 text-secondary"></i> Materiales
                                    </button>
                                </h2>
                                <div id="collapseMaterial" class="accordion-collapse collapse @(ViewBag.MaterialSeleccionado != null ? "show" : "")" aria-labelledby="headingMaterial" data-bs-parent="#accordionFiltros">
                                    <div class="accordion-body px-1 py-2">
                                        <div class="d-flex flex-column gap-1">
                                            <a href="#" onclick="cambiarFiltro('material', ''); return false;" class="py-2 px-3 rounded-2 text-decoration-none transition-all @(ViewBag.MaterialSeleccionado == null ? "bg-dark text-white fw-bold shadow-sm" : "text-secondary bg-light-hover")" style="font-size: 0.88rem;">
                                                Todos los materiales
                                            </a>
                                            @if (Model.ListaMateriales != null)
                                            {
                                                foreach (var mat in Model.ListaMateriales)
                                                {
                                                    bool activo = ViewBag.MaterialSeleccionado != null && (int)ViewBag.MaterialSeleccionado == mat.id_material;
                                                    <a href="#" onclick="cambiarFiltro('material', '@mat.id_material'); return false;" class="py-2 px-3 rounded-2 text-decoration-none transition-all @(activo ? "bg-dark text-white fw-bold shadow-sm" : "text-secondary bg-light-hover")" style="font-size: 0.88rem;">
                                                        @mat.tipo
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 4. TALLAS -->
                            <div class="accordion-item border-0 mb-3 bg-transparent">
                                <h2 class="accordion-header" id="headingTalla">
                                    <button class="accordion-button @(ViewBag.TallaSeleccionada != null ? "" : "collapsed") filter-box-btn py-2 px-3 fw-semibold text-dark shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTalla" aria-expanded="@(ViewBag.TallaSeleccionada != null ? "true" : "false")" aria-controls="collapseTalla" style="font-size: 0.95rem;">
                                        <i class="fa fa-ruler me-2 text-secondary"></i> Tallas
                                    </button>
                                </h2>
                                <div id="collapseTalla" class="accordion-collapse collapse @(ViewBag.TallaSeleccionada != null ? "show" : "")" aria-labelledby="headingTalla" data-bs-parent="#accordionFiltros">
                                    <div class="accordion-body px-1 py-2">
                                        <div class="d-flex flex-wrap gap-2 pt-1">
                                            <a href="#" onclick="cambiarFiltro('talla', ''); return false;" class="btn btn-sm @(ViewBag.TallaSeleccionada == null ? "btn-dark fw-bold" : "btn-outline-secondary") flex-fill" style="min-width: 45px;">Todas</a>
                                            @if (Model.ListaTallas != null)
                                            {
                                                foreach (var tal in Model.ListaTallas)
                                                {
                                                    bool activo = ViewBag.TallaSeleccionada != null && (int)ViewBag.TallaSeleccionada == tal.id_talla;
                                                    <a href="#" onclick="cambiarFiltro('talla', '@tal.id_talla'); return false;" class="btn btn-sm @(activo ? "btn-dark fw-bold shadow-sm" : "btn-outline-secondary")" style="min-width: 45px;">
                                                        @tal.nombre
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

                <!-- GRILLA DE PRODUCTOS -->
                <div class="col-lg-9">
                    <div class="row">
                        @if (Model.ListaProductos != null && Model.ListaProductos.Count > 0)
                        {
                            foreach (var p in Model.ListaProductos)
                            {
                                var listaFotos = !string.IsNullOrEmpty(p.imagenes_unidas) ? p.imagenes_unidas.Split('|') : new string[0];

                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card transition-all bg-white">

                                        <!-- IMAGEN / CARRUSEL -->
                                        <div class="thumb position-relative bg-light overflow-hidden" style="height: 250px;">
                                            <div id="carousel_@p.id_producto" class="carousel slide h-100" data-bs-ride="carousel" data-bs-interval="3500">
                                                <div class="carousel-inner h-100">
                                                    @if (listaFotos.Length > 0)
                                                    {
                                                        @for (int i = 0; i < listaFotos.Length; i++)
                                                        {
                                                            <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                                                <img src="@Url.Content(listaFotos[i])" class="d-block w-100 h-100 object-fit-cover" alt="Imagen de @p.nombre">
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="carousel-item h-100 active">
                                                            <img src="~/Tienda/assets/images/default.jpg" class="d-block w-100 h-100 object-fit-cover" alt="Sin imagen">
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <!-- CONTENIDO DE LA TARJETA -->
                                        <div class="card-body p-4 d-flex flex-column text-center justify-content-between">
                                            <div>
                                                <span class="text-uppercase text-muted tracking-wide" style="font-size: 0.75rem; letter-spacing: 1px;">@p.material_tipo &bull; @p.color_nombre</span>
                                                <h4 class="fw-bold text-dark mt-1 mb-2 fs-6 text-truncate" title="@p.nombre">@p.nombre</h4>
                                                <span class="text-dark fw-bold fs-5 d-block mb-3">S/ @p.precio.ToString("0.00")</span>
                                            </div>

                                            <a href="#" class="btn btn-dark w-100 py-2 rounded-3 fw-semibold shadow-sm text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">Ver Detalle</a>
                                        </div>

                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-lg-12">
                                <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
                                    <div class="card-body">
                                        <i class="fa fa-search fa-3x text-muted mb-3 opacity-50"></i>
                                        <h4 class="fw-bold text-dark">No se encontraron productos</h4>
                                        <p class="text-muted mb-4">No hay calzados que coincidan con los filtros seleccionados.</p>
                                        <a href="@Url.Action("CatalogoAvanzado", "Tienda")" class="btn btn-dark px-4 rounded-3 py-2 fw-semibold">Ver todos los productos</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>

        </form>

    </div>
</section>
<!-- ***** Catalog Area Ends ***** -->
@section Scripts {
    <script>
        function cambiarFiltro(tipo, valor) {
            if (tipo === 'categoria') document.getElementById('inputCategoria').value = valor;
            if (tipo === 'color') document.getElementById('inputColor').value = valor;
            if (tipo === 'material') document.getElementById('inputMaterial').value = valor;
            if (tipo === 'talla') document.getElementById('inputTalla').value = valor;

            guardarPosicion();
            document.getElementById('formFiltrosGlobal').submit();
        }

        function guardarPosicion() {
            // Guarda la posición actual antes de enviar el formulario
            sessionStorage.setItem('scrollpos', window.scrollY);
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Al recargar la página, si hay una posición guardada, baja automáticamente directo a los productos
            var scrollpos = sessionStorage.getItem('scrollpos');
            if (scrollpos) {
                window.scrollTo({
                    top: parseInt(scrollpos),
                    behavior: 'smooth'
                });
                sessionStorage.removeItem('scrollpos');
            }
        });
    </script>
}

<style>
    .filter-box-btn {
        background-color: #fff !important;
        border: 1px solid #ced4da !important;
        border-radius: 4px !important;
        width: 100%;
        text-align: left;
        transition: all 0.2s ease-in-out;
    }

        .filter-box-btn:hover {
            border-color: #6c757d !important;
            background-color: #f8f9fa !important;
        }

    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
        }

    .bg-light-hover:hover {
        background-color: #f1f3f5 !important;
        color: #000 !important;
    }

    .object-fit-cover {
        object-fit: cover;
        object-position: center;
    }
</style>