<!-- ***** Kids Area Starts ***** -->
<section class="section py-5" id="kids" style="background: linear-gradient(180deg, #fbf7ee 0%, #f4ede1 100%);">
    <div class="container mb-4">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
