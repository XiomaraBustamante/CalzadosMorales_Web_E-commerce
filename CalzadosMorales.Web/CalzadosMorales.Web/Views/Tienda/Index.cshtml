@{
    ViewData["Title"] = "Inicio";

    var productosHombre = ViewBag.ProductosHombre as List<CalzadosMorales.Web.Models.ProductoTienda> ?? new List<CalzadosMorales.Web.Models.ProductoTienda>();
    var productosMujer = ViewBag.ProductosMujer as List<CalzadosMorales.Web.Models.ProductoTienda> ?? new List<CalzadosMorales.Web.Models.ProductoTienda>();
    var productosNino = ViewBag.ProductosNino as List<CalzadosMorales.Web.Models.ProductoTienda> ?? new List<CalzadosMorales.Web.Models.ProductoTienda>();
}

<style>
    /* SOLUCIÓN DEFINITIVA: Empuja todo el bloque hacia abajo independientemente del menú fijo */
    .main-banner {
        position: relative !important;
        margin-top: 130px !important;
        padding: 0 0 50px 0 !important;
    }

    .main-banner .container-fluid {
        max-width: 1480px;
        margin: 0 auto;
    }

    /* Altura imponente de la izquierda igual a la referencia */
    .left-content .thumb {
        position: relative;
        height: 700px !important;
        overflow: hidden;
        border-radius: 8px;
    }

    .left-content .thumb img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
    }

    /* Espaciado entre las filas de la derecha */
    .right-content .col-lg-6 {
        margin-bottom: 30px;
    }

    /* Altura simétrica para las 4 cajas de la derecha */
    .right-content .thumb {
        position: relative;
        height: 335px !important;
        overflow: hidden;
        border-radius: 8px;
    }

    .right-content .thumb img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
        transition: transform 0.5s ease;
    }

    /* Efecto zoom al pasar el cursor */
    .thumb:hover img {
        transform: scale(1.08);
    }

    /* Filtro oscuro elegante */
    .thumb::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.38);
        z-index: 1;
    }

    /* Posicionamiento y tamaño de los textos */
    .thumb .inner-content {
        position: absolute;
        bottom: 35px;
        left: 35px;
        z-index: 2;
        color: #fff;
    }

    .left-content .thumb .inner-content {
        bottom: 60px;
        left: 60px;
    }

    .thumb .inner-content h4 {
        font-size: 26px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 8px;
    }

    .left-content .thumb .inner-content h4 {
        font-size: 46px;
        margin-bottom: 15px;
    }

    .thumb .inner-content span {
        font-size: 14px;
        color: #fff;
        font-style: italic;
    }

    .left-content .thumb .inner-content span {
        font-size: 20px;
        display: block;
        margin-bottom: 25px;
    }

    /* Botón principal */
    .main-border-button a {
        font-size: 14px;
        color: #fff;
        border: 2px solid #fff;
        padding: 12px 28px;
        display: inline-block;
        font-weight: 600;
        transition: all .3s;
        text-decoration: none;
        border-radius: 4px;
    }

    .main-border-button a:hover {
        background-color: #fff;
        color: #2a2a2a;
    }

    /* Capa de Hover para las 4 imágenes de la derecha */
    .thumb .hover-content {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.65);
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        z-index: 2;
        padding: 20px;
    }

    .thumb:hover .hover-content {
        opacity: 1;
        visibility: visible;
    }

    .thumb .hover-content .inner h4 {
        color: #fff;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .thumb .hover-content .inner p {
        color: #fff;
        font-size: 15px;
        margin-bottom: 15px;
    }

    @@media (max-width: 991px) {
        .main-banner {
            margin-top: 100px !important;
        }
        .left-content .thumb {
            height: 450px !important;
            margin-bottom: 30px;
        }
        .right-content .thumb {
            height: 280px !important;
        }
    }

    
    /* NUEVO ESTILO  */

    .transition-all {
        transition: all 0.3s ease-in-out;
    }

    .shadow-hover {
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .shadow-hover:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 40px rgba(0,0,0,0.12);
        }

    .transition-zoom {
        transition: transform 0.5s ease;
    }

    .img-contenedor:hover .transition-zoom {
        transform: scale(1.08);
    }

    .hover-elevate:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.2) !important;
        background-color: #212529 !important;
        color: #fff !important;
    }

    .object-fit-cover {
        object-fit: cover;
        object-position: center;

    }

    /* NUEVO ESTILO ICONOS  */

    .product-card-hover {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
    }

        /* Capa oscura inicial invisible */
        .product-card-hover::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 60%);
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
            z-index: 5;
            pointer-events: none;
        }

        /* Botones de acción ocultos fuera de la vista y transparentes */
        .product-card-hover .product-action-buttons {
            position: absolute;
            bottom: -20px;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: center;
            gap: 10px;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease-in-out;
            z-index: 10;
            padding-bottom: 15px;
        }

        /* Al pasar el mouse, se muestra la capa oscura y los botones flotantes suben con animación */
        .product-card-hover:hover::before {
            opacity: 1;
        }

        .product-card-hover:hover .product-action-buttons {
            bottom: 15px;
            opacity: 1;
            visibility: visible;
        }

    .product-action-buttons a {
        background: #ffffff;
        color: #1e293b;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        transition: all 0.2s ease;
        text-decoration: none;
    }

        .product-action-buttons a:hover {
            background: #d4af37;
            color: #ffffff;
            transform: translateY(-3px);
        }
</style>

<!-- ***** Main Banner Area Start ***** -->
<div class="main-banner" id="top">
    <div class="container-fluid">
        <div class="row">
            <!-- 1. BLOQUE PRINCIPAL IZQUIERDA -->
            <div class="col-lg-6">
                <div class="left-content">
                    <div class="thumb">
                        <div class="inner-content">
                            <h4>Calzados Morales</h4>
                            <span>Pisa fuerte, llega lejos y marca estilo</span>
                            <div class="main-border-button">
                                <a asp-controller="Tienda" asp-action="Zapatillas">Ver Zapatillas</a>
                            </div>
                        </div>
                        <img src="~/Tienda/assets/images/calzadomoralescuadro.jpeg" alt="Banner Zapatillas">
                    </div>
                </div>
            </div>

            <!-- 2. BLOQUES LATERALES DERECHA -->
            <div class="col-lg-6">
                <div class="right-content">
                    <div class="row">
                        <!-- SANDALIAS -->
                        <div class="col-lg-6">
                            <div class="thumb">
                                <div class="inner-content">
                                    <h4>Sandalias</h4>
                                    <span>Frescura para tus días</span>
                                </div>
                                <div class="hover-content">
                                    <div class="inner">
                                        <h4>Sandalias</h4>
                                        <p>Frescura y comodidad para tus días de verano.</p>
                                        <div class="main-border-button">
                                            <a asp-controller="Tienda" asp-action="Sandalias">Explorar</a>
                                        </div>
                                    </div>
                                </div>
                                <img src="~/Tienda/assets/images/sandaliacuadro.jpg" alt="Sandalias Banner">
                            </div>
                        </div>

                        <!-- ZAPATOS -->
                        <div class="col-lg-6">
                            <div class="thumb">
                                <div class="inner-content">
                                    <h4>Zapatos</h4>
                                    <span>Elegancia y distinción</span>
                                </div>
                                <div class="hover-content">
                                    <div class="inner">
                                        <h4>Zapatos</h4>
                                        <p>Elegancia y distinción para ocasiones importantes.</p>
                                        <div class="main-border-button">
                                            <a asp-controller="Tienda" asp-action="Zapatos">Explorar</a>
                                        </div>
                                    </div>
                                </div>
                                <img src="~/Tienda/assets/images/zapatoscuadro.jpg" alt="Zapatos Banner">
                            </div>
                        </div>

                        <!-- BOTINES -->
                        <div class="col-lg-6">
                            <div class="thumb">
                                <div class="inner-content">
                                    <h4>Botines</h4>
                                    <span>Dominación en la cancha</span>
                                </div>
                                <div class="hover-content">
                                    <div class="inner">
                                        <h4>Botines</h4>
                                        <p>Máximo agarre y control para dominar la cancha.</p>
                                        <div class="main-border-button">
                                            <a asp-controller="Tienda" asp-action="Botines">Explorar</a>
                                        </div>
                                    </div>
                                </div>
                                <img src="~/Tienda/assets/images/botinescuadro.jpeg" alt="Botines Banner">
                            </div>
                        </div>

                        <!-- MOCASINES -->
                        <div class="col-lg-6">
                            <div class="thumb">
                                <div class="inner-content">
                                    <h4>Mocasines</h4>
                                    <span>Confort para el día a día</span>
                                </div>
                                <div class="hover-content">
                                    <div class="inner">
                                        <h4>Mocasines</h4>
                                        <p>Estilo clásico y confort superior diario.</p>
                                        <div class="main-border-button">
                                            <a asp-controller="Tienda" asp-action="Mocasines">Explorar</a>
                                        </div>
                                    </div>
                                </div>
                                <img src="~/Tienda/assets/images/mocasionesfondo.jpeg" alt="Mocasines Banner">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ***** Main Banner Area End ***** -->


<!-- ***** Main Banner Area Start ***** -->
<div class="page-heading" id="top" style="background: linear-gradient(135deg, rgba(20,20,20,0.95) 0%, rgba(35,35,35,0.98) 100%), url('@Url.Content("~/Tienda/assets/images/default.jpg")'); background-position: center center; background-repeat: no-repeat; background-size: cover; margin-top: -30px; height: 320px; display: flex; align-items: center; justify-content: center; position: relative; box-shadow: inset 0 0 30px rgba(0,0,0,0.8);">
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at center, rgba(212,175,55,0.15) 0%, rgba(0,0,0,0.7) 90%); z-index: 1;"></div>

    <div class="container" style="z-index: 2;">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="text-uppercase mb-2" style="font-size: 2.6rem; font-family: 'Playfair Display', 'Georgia', serif; font-weight: 700; letter-spacing: 2px; background: linear-gradient(to right, #cfb53b, #fff2b2, #d4af37, #e6ca65); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-shadow: 0px 2px 10px rgba(0,0,0,0.6);">
                    Calzados Morales
                </h2>
                <div style="width: 60px; height: 2px; background: linear-gradient(to right, transparent, #d4af37, transparent); margin: 0 auto 12px auto;"></div>
                <p class="m-0 text-light" style="font-size: 1.15rem; font-style: italic; font-weight: 300; letter-spacing: 0.5px; opacity: 0.9;">
                    "Pisa con firmeza, camina con estilo; la elegancia comienza desde el primer paso."
                </p>
            </div>
        </div>
    </div>
</div>
<!-- ***** Main Banner Area End ***** -->


<!-- ***** Men Area Starts ***** -->
<section class="section py-5" id="men" style="background: linear-gradient(180deg, #f4f6f9 0%, #e9edf2 100%); border-top: 1px solid #dcdfe5; border-bottom: 1px solid #dcdfe5;">
    <div class="container mb-4">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <div class="section-heading p-4" style="background: linear-gradient(135deg, #ffffff 0%, #f7f9fc 100%); border-radius: 12px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04); border-left: 4px solid #2c3e50; border-right: 1px solid #e2e8f0; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
                    <h2 style="font-family: 'Playfair Display', serif; font-weight: 700; color: #1e293b; font-size: 2.2rem; margin-bottom: 8px;">Colección Exclusiva para Hombres</h2>
                    <span style="font-family: 'Georgia', serif; font-style: italic; color: #64748b; font-size: 1.05rem;">Diseños modernos, máxima comodidad y distinción para cada aventura diaria.</span>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="men-item-carousel">
                    <div class="owl-men-item owl-carousel">
                        @if (productosHombre != null && productosHombre.Count > 0)
                        {
                            @foreach (var p in productosHombre)
                            {
                                var listaFotos = !string.IsNullOrEmpty(p.ImagenesUnidas) ? p.ImagenesUnidas.Split('|') : new string[0];
                                <div class="item" style="background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 6px 18px rgba(30,41,59,0.08); border: 1px solid #e2e8f0; margin: 5px; display: flex; flex-direction: column;">

                                    <div class="thumb product-card-hover" style="width: 100%; position: relative; background: #f1f5f9;">
                                        <div id="carousel_hom_@p.IdProducto" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                                            <div class="carousel-inner">
                                                @if (listaFotos.Length > 0)
                                                {
                                                    @for (int i = 0; i < listaFotos.Length; i++)
                                                    {
                                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                                            <img src="@listaFotos[i]" class="d-block w-100" alt="@p.Nombre" style="height: 250px; object-fit: cover; object-position: center;">
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="carousel-item active">
                                                        <img src="@Url.Content("~/Tienda/assets/images/default.png")" class="d-block w-100" alt="Sin imagen" style="height: 250px; object-fit: cover; object-position: center;">
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <!-- Botones flotantes de iconos (aparecen solo en hover) -->
                                        <div class="product-action-buttons">
                                            <a href="@Url.Action("Detalle", "Tienda", new { idProducto = p.IdProducto })" title="Ver Detalle"><i class="fa fa-eye"></i></a>
                                            <a href="#" title="Favorito"><i class="fa fa-star"></i></a>
                                            <a href="@Url.Action("Detalle", "Tienda", new { idProducto = p.IdProducto })" title="Añadir al Carrito"><i class="fa fa-shopping-cart"></i></a>
                                        </div>
                                    </div>

                                    <div style="padding: 15px; display: flex; flex-direction: column; align-items: center; width: 100%; background: #ffffff; flex-grow: 1;">
                                        <h4 style="font-weight: 600; color: #1e293b; font-size: 1rem; margin-bottom: 8px; text-align: center; width: 100%; min-height: 40px; display: flex; align-items: center; justify-content: center; line-height: 1.3;">@p.Nombre</h4>

                                        <ul style="list-style: none; display: flex; gap: 4px; padding: 0; margin: 0 0 8px 0; justify-content: center; width: 100%;">
                                            <li><i class="fa fa-star text-warning"></i></li>
                                            <li><i class="fa fa-star text-warning"></i></li>
                                            <li><i class="fa fa-star text-warning"></i></li>
                                            <li><i class="fa fa-star text-warning"></i></li>
                                            <li><i class="fa fa-star text-warning"></i></li>
                                        </ul>

                                        <span style="color: #2563eb; font-weight: 700; font-size: 1.15rem; margin-bottom: 5px; display: block; width: 100%; text-align: center;">S/ @p.Precio.ToString("0.00")</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-5">
            <div class="col-lg-12 text-center">
                <a href="@Url.Action("Catalogo", "Tienda", new { categoria = "Hombre" })" class="btn px-5 py-2 text-white" style="background: linear-gradient(135deg, #1e293b, #334155); border-radius: 25px; font-weight: 600; box-shadow: 0 4px 12px rgba(30,41,59,0.2); border: none;">
                    Ver más modelos de Hombre &raquo;
                </a>
            </div>
        </div>
    </div>
</section>
<!-- ***** Men Area Ends ***** -->
