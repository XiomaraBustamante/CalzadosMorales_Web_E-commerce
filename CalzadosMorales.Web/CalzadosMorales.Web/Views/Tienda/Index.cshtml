@{
    ViewData["Title"] = "Inicio";
}

<style>
    /* SOLUCIÓN DEFINITIVA: Empuja todo el bloque hacia abajo independientemente del menú fijo */
    .main-banner {
        position: relative !important;
        margin-top: 130px !important;
        padding: 0 0 50px 0 !important;
    }

    .main-banner .container-fluid {
        max-width: 1480px;
        margin: 0 auto;
    }

    /* Altura imponente de la izquierda igual a la referencia */
    .left-content .thumb {
        position: relative;
        height: 700px !important;
        overflow: hidden;
        border-radius: 8px;
    }

    .left-content .thumb img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
    }

    /* Espaciado entre las filas de la derecha */
    .right-content .col-lg-6 {
        margin-bottom: 30px;
    }

    /* Altura simétrica para las 4 cajas de la derecha */
    .right-content .thumb {
        position: relative;
        height: 335px !important;
        overflow: hidden;
        border-radius: 8px;
    }

    .right-content .thumb img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center !important;
        transition: transform 0.5s ease;
    }

    /* Efecto zoom al pasar el cursor */
    .thumb:hover img {
        transform: scale(1.08);
    }

    /* Filtro oscuro elegante */
    .thumb::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.38);
        z-index: 1;
    }

    /* Posicionamiento y tamaño de los textos */
    .thumb .inner-content {
        position: absolute;
        bottom: 35px;
        left: 35px;
        z-index: 2;
        color: #fff;
    }

    .left-content .thumb .inner-content {
        bottom: 60px;
        left: 60px;
    }

    .thumb .inner-content h4 {
        font-size: 26px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 8px;
    }

    .left-content .thumb .inner-content h4 {
        font-size: 46px;
        margin-bottom: 15px;
    }

    .thumb .inner-content span {
        font-size: 14px;
        color: #fff;
        font-style: italic;
    }

    .left-content .thumb .inner-content span {
        font-size: 20px;
        display: block;
        margin-bottom: 25px;
    }

    /* Botón principal */
    .main-border-button a {
        font-size: 14px;
        color: #fff;
        border: 2px solid #fff;
        padding: 12px 28px;
        display: inline-block;
        font-weight: 600;
        transition: all .3s;
        text-decoration: none;
        border-radius: 4px;
    }

    .main-border-button a:hover {
        background-color: #fff;
        color: #2a2a2a;
    }

    /* Capa de Hover para las 4 imágenes de la derecha */
    .thumb .hover-content {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.65);
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        z-index: 2;
        padding: 20px;
    }

    .thumb:hover .hover-content {
        opacity: 1;
        visibility: visible;
    }

    .thumb .hover-content .inner h4 {
        color: #fff;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .thumb .hover-content .inner p {
        color: #fff;
        font-size: 15px;
        margin-bottom: 15px;
    }

    @@media (max-width: 991px) {
        .main-banner {
            margin-top: 100px !important;
        }
        .left-content .thumb {
            height: 450px !important;
            margin-bottom: 30px;
        }
        .right-content .thumb {
            height: 280px !important;
        }
    }
</style>

