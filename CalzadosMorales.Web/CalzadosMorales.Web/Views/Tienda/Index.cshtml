                        @if (productosNino != null && productosNino.Count > 0)
                        {
                            @foreach (var p in productosNino)
                            {
                                var listaFotos = !string.IsNullOrEmpty(p.ImagenesUnidas) ? p.ImagenesUnidas.Split('|') : new string[0];
                                <div class="item" style="background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 6px 18px rgba(180,130,30,0.08); border: 1px solid #eedebe; margin: 5px; display: flex; flex-direction: column;">

                                    <div class="thumb product-card-hover" style="width: 100%; position: relative; background: #fcf8f0;">
                                        <div id="carousel_kid_@p.IdProducto" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                                            <div class="carousel-inner">
                                                @if (listaFotos.Length > 0)
                                                {
                                                    @for (int i = 0; i < listaFotos.Length; i++)
                                                    {
                                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                                            <img src="@listaFotos[i]" class="d-block w-100" alt="@p.Nombre" style="height: 250px; object-fit: cover; object-position: center;">
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="carousel-item active">
                                                        <img src="@Url.Content("~/Tienda/assets/images/default.png")" class="d-block w-100" alt="Sin imagen" style="height: 250px; object-fit: cover; object-position: center;">
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <!-- Botones flotantes de iconos (aparecen solo en hover) -->
                                        <div class="product-action-buttons">
                                            <a href="@Url.Action("Detalle", "Tienda", new { idProducto = p.IdProducto })" title="Ver Detalle"><i class="fa fa-eye"></i></a>
                                            <a href="#" title="Favorito"><i class="fa fa-star"></i></a>
                                            <a href="@Url.Action("Detalle", "Tienda", new { idProducto = p.IdProducto })" title="Añadir al Carrito"><i class="fa fa-shopping-cart"></i></a>
                                        </div>
                                    </div>

                                    <div style="padding: 15px; display: flex; flex-direction: column; align-items: center; width: 100%; background: #ffffff; flex-grow: 1;">
                                        <h4 style="font-weight: 600; color: #423102; font-size: 1rem; margin-bottom: 8px; text-align: center; width: 100%; min-height: 40px; display: flex; align-items: center; justify-content: center; line-height: 1.3;">@p.Nombre</h4>

                                        <ul style="list-style: none; display: flex; gap: 4px; padding: 0; margin: 0 0 8px 0; justify-content: center; width: 100%;">
                                            <li><i class="fa fa-star text-warning"></i></li>
                                            <li><i class="fa fa-star text-warning"></i></li>
                                            <li><i class="fa fa-star text-warning"></i></li>
                                            <li><i class="fa fa-star text-warning"></i></li>
                                            <li><i class="fa fa-star text-warning"></i></li>
                                        </ul>

                                        <span style="color: #b8860b; font-weight: 700; font-size: 1.15rem; margin-bottom: 5px; display: block; width: 100%; text-align: center;">S/ @p.Precio.ToString("0.00")</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-5">
            <div class="col-lg-12 text-center">
                <a href="@Url.Action("Catalogo", "Tienda", new { categoria = "Niño" })" class="btn px-5 py-2 text-white" style="background: linear-gradient(135deg, #b8860b, #996f08); border-radius: 25px; font-weight: 600; box-shadow: 0 4px 12px rgba(184,134,11,0.25); border: none;">
                    Ver más modelos de Niños &raquo;
                </a>
            </div>
        </div>
    </div>
