<!-- ***** Header Area Start ***** -->
<header class="header-area" style="background: #0f172a; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4); position: relative; width: 100%; margin-bottom: 0 !important; padding-bottom: 0 !important;">
    <!-- Línea superior decorativa de acento corporativo -->
    <div style="height: 4px; background: linear-gradient(90deg, #3b82f6 0%, #10b981 50%, #f59e0b 100%);"></div>

    <div class="container-fluid" style="padding-left: 40px; padding-right: 40px;">
        <div class="row">
            <div class="col-12" style="padding: 0 !important; margin: 0 !important;">

                <!-- Navbar optimizado: altura compacta de 95px sin espacios vacíos abajo -->
                <nav class="main-nav" style="display: flex !important; justify-content: space-between !important; align-items: center !important; height: 95px !important; min-height: 95px !important; padding: 0 !important; margin: 0 !important; float: none !important; position: static !important;">

                    <!-- ***** Logo Start ***** -->
                    <a href="@Url.Action("Index", "Tienda")" class="logo" style="margin: 0 !important; padding: 6px 12px !important; display: flex !important; align-items: center !important; justify-content: center !important; background: #ffffff !important; border-radius: 8px !important; box-shadow: 0 3px 10px rgba(0,0,0,0.3); float: none !important; position: static !important; transform: none !important;">
                        <img src="~/Tienda/assets/images/LogoTienda.png" alt="Calzados Morales" style="width: 145px; height: auto; display: block;">
                    </a>
                    <!-- ***** Logo End ***** -->

                    <!-- ***** Menu Start ***** -->
                    <ul class="nav" style="display: flex !important; align-items: center !important; margin: 0 !important; padding: 0 !important; list-style: none !important; gap: 8px !important; float: none !important; position: static !important;">

                        <!-- Inicio -->
                        <li>
                            <a href="@Url.Action("Index", "Tienda")" style="color: #ffffff !important; font-weight: 500; font-size: 14px; padding: 8px 12px; border-radius: 6px; transition: all 0.2s ease; display: flex; align-items: center; gap: 6px;" onmouseover="this.style.backgroundColor='#1e293b'; this.style.color='#60a5fa' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#ffffff' !important;">
                                <i class="fa fa-home" style="color: #60a5fa;"></i> Inicio
                            </a>
                        </li>

                        <!-- Hombres -->
                        <li>
                            <a href="@Url.Action("Catalogo", "Tienda", new { categoria = "Hombre" })" style="color: #ffffff !important; font-weight: 500; font-size: 14px; padding: 8px 12px; border-radius: 6px; transition: all 0.2s ease; display: flex; align-items: center; gap: 6px;" onmouseover="this.style.backgroundColor='#1e293b'; this.style.color='#60a5fa' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#ffffff' !important;">
                                <i class="fa fa-male" style="color: #60a5fa;"></i> Hombres
                            </a>
                        </li>

                        <!-- Mujeres -->
                        <li>
                            <a href="@Url.Action("Catalogo", "Tienda", new { categoria = "Mujer" })" style="color: #ffffff !important; font-weight: 500; font-size: 14px; padding: 8px 12px; border-radius: 6px; transition: all 0.2s ease; display: flex; align-items: center; gap: 6px;" onmouseover="this.style.backgroundColor='#1e293b'; this.style.color='#f43f5e' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#ffffff' !important;">
                                <i class="fa fa-female" style="color: #f43f5e;"></i> Mujeres
                            </a>
                        </li>

                        <!-- Niños -->
                        <li>
                            <a href="@Url.Action("Catalogo", "Tienda", new { categoria = "Niño" })" style="color: #ffffff !important; font-weight: 500; font-size: 14px; padding: 8px 12px; border-radius: 6px; transition: all 0.2s ease; display: flex; align-items: center; gap: 6px;" onmouseover="this.style.backgroundColor='#1e293b'; this.style.color='#fbbf24' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#ffffff' !important;">
                                <i class="fa fa-child" style="color: #fbbf24;"></i> Niños
                            </a>
                        </li>

                        <!-- Ver Todos los Productos (Desplegable) -->
                        <li class="submenu" style="position: relative;">
                            <a href="@Url.Action("CatalogoAvanzado", "Tienda")" style="color: #ffffff !important; font-weight: 500; font-size: 14px; padding: 8px 12px; border-radius: 6px; transition: all 0.2s ease; display: flex; align-items: center; gap: 6px;" onmouseover="this.style.backgroundColor='#1e293b'; this.style.color='#34d399' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#ffffff' !important;">
                                <i class="fa fa-th-large" style="color: #34d399;"></i> Ver Todos <i class="fa fa-angle-down" style="font-size: 11px; margin-left: 2px;"></i>
                            </a>
                            <ul style="background: #ffffff !important; box-shadow: 0 10px 25px rgba(0,0,0,0.25); border-radius: 8px; padding: 8px 0 !important; border: 1px solid #e2e8f0; min-width: 180px; z-index: 9999; position: absolute; list-style: none !important;">
                                <li><a href="@Url.Action("Catalogo", "Tienda", new { categoria = "Zapatillas" })" style="color: #1e293b !important; padding: 10px 18px !important; display: block !important; font-size: 13px; font-weight: 600;" onmouseover="this.style.backgroundColor='#f1f5f9'; this.style.color='#2563eb' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#1e293b' !important;">Zapatillas</a></li>
                                <li><a href="@Url.Action("Catalogo", "Tienda", new { categoria = "Sandalias" })" style="color: #1e293b !important; padding: 10px 18px !important; display: block !important; font-size: 13px; font-weight: 600;" onmouseover="this.style.backgroundColor='#f1f5f9'; this.style.color='#2563eb' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#1e293b' !important;">Sandalias</a></li>
                                <li><a href="@Url.Action("Catalogo", "Tienda", new { categoria = "Zapatos" })" style="color: #1e293b !important; padding: 10px 18px !important; display: block !important; font-size: 13px; font-weight: 600;" onmouseover="this.style.backgroundColor='#f1f5f9'; this.style.color='#2563eb' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#1e293b' !important;">Zapatos</a></li>
                                <li><a href="@Url.Action("Catalogo", "Tienda", new { categoria = "Botines" })" style="color: #1e293b !important; padding: 10px 18px !important; display: block !important; font-size: 13px; font-weight: 600;" onmouseover="this.style.backgroundColor='#f1f5f9'; this.style.color='#2563eb' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#1e293b' !important;">Botines</a></li>
                                <li><a href="@Url.Action("Catalogo", "Tienda", new { categoria = "Mocasines" })" style="color: #1e293b !important; padding: 10px 18px !important; display: block !important; font-size: 13px; font-weight: 600;" onmouseover="this.style.backgroundColor='#f1f5f9'; this.style.color='#2563eb' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#1e293b' !important;">Mocasines</a></li>
                            </ul>
                        </li>

                        <!-- Secciones (Desplegable) -->
                        <li class="submenu" style="position: relative;">
                            <a href="javascript:;" style="color: #ffffff !important; font-weight: 500; font-size: 14px; padding: 8px 12px; border-radius: 6px; transition: all 0.2s ease; display: flex; align-items: center; gap: 6px;" onmouseover="this.style.backgroundColor='#1e293b'; this.style.color='#a78bfa' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#ffffff' !important;">
                                <i class="fa fa-info-circle" style="color: #a78bfa;"></i> Secciones <i class="fa fa-angle-down" style="font-size: 11px; margin-left: 2px;"></i>
                            </a>
                            <ul style="background: #ffffff !important; box-shadow: 0 10px 25px rgba(0,0,0,0.25); border-radius: 8px; padding: 8px 0 !important; border: 1px solid #e2e8f0; min-width: 180px; z-index: 9999; position: absolute; list-style: none !important;">
                                <li><a href="#" style="color: #1e293b !important; padding: 10px 18px !important; display: block !important; font-size: 13px; font-weight: 600;" onmouseover="this.style.backgroundColor='#f1f5f9'; this.style.color='#2563eb' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#1e293b' !important;">Acerca de nosotros</a></li>
                                <li><a href="#" style="color: #1e293b !important; padding: 10px 18px !important; display: block !important; font-size: 13px; font-weight: 600;" onmouseover="this.style.backgroundColor='#f1f5f9'; this.style.color='#2563eb' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#1e293b' !important;">Contáctanos</a></li>
                            </ul>
                        </li>

                        <!-- CONDICIONAL DE AUTENTICACIÓN (CLIENTE) -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Si ha iniciado sesión: Muestra el icono, su correo y menú para cerrar sesión -->
                            <li class="submenu" style="margin-left: 10px; position: relative;">
                                <a href="javascript:;" style="color: #ffffff !important; font-weight: 500; font-size: 14px; padding: 6px 12px; border-radius: 30px; background: #1e293b; display: flex; align-items: center; gap: 8px; border: 1px solid #334155;">
                                    <i class="fa fa-user-circle" style="font-size: 18px; color: #60a5fa;"></i>
                                    <span>@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</span>
                                    <i class="fa fa-angle-down" style="font-size: 11px;"></i>
                                </a>
                                <!-- Menú desplegable con el formulario apuntando a CerrarSesion -->
                                <ul style="background: #ffffff !important; box-shadow: 0 10px 25px rgba(0,0,0,0.25); border-radius: 8px; padding: 8px 0 !important; border: 1px solid #e2e8f0; min-width: 160px; z-index: 9999; position: absolute; right: 0; list-style: none !important;">
                                    <li>
                                        <form asp-controller="ClienteAuth" asp-action="CerrarSesion" method="post" id="logoutClienteForm" style="display: none;"></form>
                                        <a href="javascript:document.getElementById('logoutClienteForm').submit();" style="color: #1e293b !important; padding: 10px 18px !important; display: flex !important; align-items: center; gap: 8px; font-size: 13px; font-weight: 600;" onmouseover="this.style.backgroundColor='#f1f5f9'; this.style.color='#dc2626' !important;" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#1e293b' !important;">
                                            <i class="fa fa-sign-out" style="color: #dc2626;"></i> Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- Si NO ha iniciado sesión: Muestra el botón de Iniciar Sesión -->
                            <li style="margin-left: 10px;">
                                <a href="@Url.Action("Index", "ClienteAuth")" style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: #ffffff !important; padding: 8px 18px; border-radius: 30px; font-weight: 600; font-size: 13px; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(59, 130, 246, 0.6)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(59, 130, 246, 0.4)';">
                                    <i class="fa fa-user-circle" style="font-size: 15px;"></i> Iniciar Sesión
                                </a>
                            </li>
                        }

                    </ul>

                    <a class='menu-trigger'>
                        <span>Menú</span>
                    </a>
                    <!-- ***** Menu End ***** -->

                </nav>
            </div>
        </div>
    </div>
</header>
<!-- ***** Header Area End ***** -->