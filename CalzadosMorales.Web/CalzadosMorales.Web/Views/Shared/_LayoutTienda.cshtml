<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Calzados Morales</title>

    <!-- ESTILOS DE LA PLANTILLA HEXASHOP (Rutas exactas según tu Explorador de Soluciones) -->
    <link rel="stylesheet" href="~/Tienda/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Tienda/assets/css/font-awesome.css" />
    <link rel="stylesheet" href="~/Tienda/assets/css/owl-carousel.css" />
    <link rel="stylesheet" href="~/Tienda/assets/css/templatemo-hexashop.css" />

    <!-- TUS ESTILOS PERSONALIZADOS -->
    <link rel="stylesheet" href="~/Tienda/assets/css/estios-tienda.css" />
</head>
<body>

    <!-- Tu Navbar reutilizable -->
    @await Html.PartialAsync("_TiendaNavbar")

    <main role="main">
        @RenderBody()
    </main>

    <!-- ***** Footer Start ***** -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-lg-3">
                    <div class="first-item">
                        <div class="logo">
                            <img src="~/Tienda/assets/images/white-logo.png" alt="Calzados Morales">
                        </div>
                        <ul>
                            <li><a href="#">Jr. Los Proceres, Lima, Perú</a></li>
                            <li><a href="#">contacto@calzadosmorales.com</a></li>
                            <li><a href="#">010-020-0340</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-3">
                    <h4>Shopping &amp; Categories</h4>
                    <ul>
                        <li><a asp-controller="Tienda" asp-action="Zapatillas">Zapatillas</a></li>
                        <li><a asp-controller="Tienda" asp-action="Sandalias">Sandalias</a></li>
                        <li><a asp-controller="Tienda" asp-action="Zapatos">Zapatos</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h4>Useful Links</h4>
                    <ul>
                        <li><a asp-controller="Tienda" asp-action="Index">Homepage</a></li>
                        <li><a href="#">About Us</a></li>
                        <li><a href="#">Help</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h4>Help &amp; Information</h4>
                    <ul>
                        <li><a href="#">FAQ's</a></li>
                        <li><a href="#">Shipping</a></li>
                        <li><a href="#">Tracking ID</a></li>
                    </ul>
                </div>
                <div class="col-lg-12">
                    <div class="under-footer">
                        <p>Copyright © 2026 Calzados Morales Co., Ltd. All Rights Reserved. 
                        <br>Design: <a href="https://templatemo.com" target="_parent">TemplateMo</a></p>
                        <ul>
                            <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                            <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                            <li><a href="#"><i class="fa fa-linkedin"></i></a></li>
                            <li><a href="#"><i class="fa fa-behance"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- ***** Footer End ***** -->

    <!-- SCRIPTS -->
    <script src="~/Tienda/assets/js/jquery-2.1.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- PLUGINS DE LA PLANTILLA NECESARIOS PARA LOS CARRUSELES -->
    <script src="~/Tienda/assets/js/owl-carousel.js"></script>
    <script src="~/Tienda/assets/js/accordions.js"></script>
    <script src="~/Tienda/assets/js/datepicker.js"></script>
    <script src="~/Tienda/assets/js/scrollreveal.min.js"></script>
    <script src="~/Tienda/assets/js/waypoints.min.js"></script>
    <script src="~/Tienda/assets/js/jquery.counterup.min.js"></script>
    <script src="~/Tienda/assets/js/imgfix.min.js"></script> 
    <script src="~/Tienda/assets/js/slick.js"></script> 
    <script src="~/Tienda/assets/js/lightbox.js"></script> 
    <script src="~/Tienda/assets/js/isotope.js"></script> 

    <!-- Script principal de la plantilla -->
    <script src="~/Tienda/assets/js/custom.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>